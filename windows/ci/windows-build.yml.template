# All recursive dependency sources are publicly accessible at their pinned refs.
name: Windows build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      mode:
        description: Explicit pinned or integration-only candidate mode
        type: choice
        options: [pinned, candidate]
        default: pinned
      backend_sha:
        description: Candidate backend, exactly 40 lowercase hex characters (candidate mode only)
        type: string
      shell_sha:
        description: Exact shell commit, 40 lowercase hex characters (defaults to workflow SHA)
        type: string

permissions:
  contents: read

concurrency:
  group: windows-build-${{ github.event_name }}-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  scope:
    name: Change scope
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    outputs:
      native: ${{ steps.changes.outputs.native }}
    steps:
      - name: Refuse mutable dispatch inputs
        shell: pwsh
        env:
          PAIR_MODE: ${{ inputs.mode || 'pinned' }}
          PAIR_SHELL: ${{ inputs.shell_sha || github.sha }}
          PAIR_BACKEND: ${{ inputs.backend_sha }}
        run: |
          if ($env:PAIR_SHELL -cnotmatch '^[a-f0-9]{40}$') { throw 'Immutable shell SHA required: exactly 40 lowercase hex characters.' }
          if ($env:PAIR_MODE -eq 'candidate' -and $env:PAIR_BACKEND -cnotmatch '^[a-f0-9]{40}$') {
            throw 'Immutable candidate backend SHA required: exactly 40 lowercase hex characters.'
          }
          if ($env:PAIR_MODE -eq 'pinned' -and $env:PAIR_BACKEND) { throw 'Candidate SHA requires mode=candidate.' }
      - name: Checkout public sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Determine native build scope
        id: changes
        shell: pwsh
        env:
          CHANGE_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}
          CHANGE_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          & ./windows/ci/Get-NativeBuildRequired.ps1 -Base $env:CHANGE_BASE -Head $env:CHANGE_HEAD

  checks:
    name: Fast regressions
    needs: scope
    runs-on: windows-2022
    timeout-minutes: 10
    steps:
      - name: Checkout public sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          persist-credentials: false
      - name: Python 3.12
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Node 24
        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: '24'
      - name: Source, lifecycle, quota and JavaScript regressions
        shell: pwsh
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Test-Validation.ps1 `
            -Suite Unit -Python python -OutputRoot "$env:RUNNER_TEMP\validation-unit"
          if ($LASTEXITCODE -ne 0) { throw 'Fast regressions failed.' }
      - name: Sanitized test summary
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: unit-summary-${{ github.run_id }}
          path: ${{ runner.temp }}/validation-unit/summary.json
          if-no-files-found: ignore
          retention-days: 3

  packaging:
    name: Installer and colour regressions
    needs: scope
    runs-on: windows-2022
    timeout-minutes: 15
    steps:
      - name: Checkout public sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          persist-credentials: false
      - name: Python 3.12
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Installer, rollback and scheme-generation contracts
        shell: pwsh
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Test-Validation.ps1 `
            -Suite Packaging -OutputRoot "$env:RUNNER_TEMP\validation-packaging"
          if ($LASTEXITCODE -ne 0) { throw 'Installer regressions failed.' }
      - name: Prepare isolated colour-test dependencies
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $venv = "$env:RUNNER_TEMP\colour-test-venv"
          python -m venv $venv
          if ($LASTEXITCODE -ne 0) { throw 'Colour-test environment creation failed.' }
          $python = "$venv\Scripts\python.exe"
          & $python -m pip install --disable-pip-version-check --no-deps --only-binary=:all: `
            --require-hashes -r windows/scripts/scheme/requirements.lock.txt
          if ($LASTEXITCODE -ne 0) { throw 'Locked colour dependencies failed.' }
          $lock = Get-Content windows/sources.lock.json -Raw | ConvertFrom-Json
          if ($lock.schemeCli.revision -notmatch '^[a-f0-9]{40}$') { throw 'Invalid colour CLI pin.' }
          & $python -m pip install --disable-pip-version-check --no-deps --ignore-requires-python `
            "git+https://github.com/caelestia-dots/cli@$($lock.schemeCli.revision)"
          if ($LASTEXITCODE -ne 0) { throw 'Pinned colour CLI installation failed.' }
      - name: Colour worker and wallpaper-input regressions
        shell: pwsh
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Test-Validation.ps1 `
            -Suite Scheme -Python "$env:RUNNER_TEMP\colour-test-venv\Scripts\python.exe" `
            -OutputRoot "$env:RUNNER_TEMP\validation-scheme"
          if ($LASTEXITCODE -ne 0) { throw 'Colour regressions failed.' }
      - name: Sanitized test summaries
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: packaging-summary-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/validation-packaging/summary.json
            ${{ runner.temp }}/validation-scheme/summary.json
          if-no-files-found: ignore
          retention-days: 3

  reuse:
    name: Verified native reuse and offscreen regressions
    needs: scope
    if: github.event_name == 'pull_request' && needs.scope.outputs.native == 'reuse'
    runs-on: windows-2022
    timeout-minutes: 15
    permissions:
      contents: read
      actions: read
    outputs:
      mode: ${{ steps.verify.outcome == 'success' && steps.runtime.outcome == 'success' && 'reuse' || 'full' }}
    env:
      BUILD_ROOT: C:\b-public
      TOOL_ROOT: C:\t-public
      PIP_CACHE_DIR: C:\t-public\pip
      REUSE_BASE: ${{ github.event.pull_request.base.sha }}
      REUSE_HEAD: ${{ github.event.pull_request.head.sha }}
      PYTHONDONTWRITEBYTECODE: '1'
    defaults:
      run:
        shell: pwsh
    steps:
      - name: Checkout PR sources for independent verification and tests
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          submodules: recursive
          persist-credentials: false
      - name: Python 3.12
        id: python
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Locate newest validated main ancestor of this PR
        id: producer
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python -I -B windows/ci/native_reuse.py discover --base $env:REUSE_BASE --head $env:REUSE_HEAD `
            --shell $env:GITHUB_WORKSPACE --output $env:GITHUB_OUTPUT
          if ($LASTEXITCODE -ne 0) { throw 'No reusable trusted producer; selecting full build.' }
      - name: Download trusted native reuse artifact
        id: download
        if: steps.producer.outcome == 'success'
        continue-on-error: true
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: ${{ steps.producer.outputs.artifact }}
          run-id: ${{ steps.producer.outputs.run-id }}
          github-token: ${{ github.token }}
          path: C:/
      - name: Independently verify sources and every restored hash
        id: verify
        if: steps.download.outcome == 'success'
        continue-on-error: true
        env:
          PRODUCER_RUN: ${{ steps.producer.outputs.run-id }}
          PRODUCER_ARTIFACT: ${{ steps.producer.outputs.artifact }}
          PRODUCER_BASE: ${{ steps.producer.outputs.base }}
        run: |
          python -I -B windows/ci/native_reuse.py verify --base $env:PRODUCER_BASE --head $env:REUSE_HEAD `
            --shell $env:GITHUB_WORKSPACE --build $env:BUILD_ROOT --inventory C:/reuse-files.json `
            --run-id $env:PRODUCER_RUN --artifact $env:PRODUCER_ARTIFACT --output C:/native-reuse-summary.json
          if ($LASTEXITCODE -ne 0) { throw 'Reuse verification refused; selecting full build.' }
      - name: Restore versioned tooling (never save)
        if: steps.verify.outcome == 'success'
        continue-on-error: true
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          key: windows-x64-tools-contract-v1-py${{ steps.python.outputs.python-version }}-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}
          path: |
            C:\t-public\Qt
            C:\t-public\downloads
            C:\t-public\pip
            C:\t-public\clang+llvm-20.1.8-x86_64-pc-windows-msvc
            C:\t-public\deps\CLI11-2.5.0
      - name: Require Qt runtime and provision hash-locked CTest only
        id: runtime
        if: steps.verify.outcome == 'success'
        continue-on-error: true
        run: |
          $spec = Get-Content windows/toolchain.json -Raw | ConvertFrom-Json
          $qt = Join-Path $env:TOOL_ROOT $spec.qtDirectory
          foreach ($file in @('bin/qtpaths.exe', 'bin/Qt6Quick.dll', 'plugins/platforms/qoffscreen.dll')) {
            if (-not (Test-Path -LiteralPath (Join-Path $qt $file))) { throw 'Qt cache unavailable; selecting full build.' }
          }
          python -m venv "$env:TOOL_ROOT/tools"
          if ($LASTEXITCODE -ne 0) { throw 'CTest environment unavailable; selecting full build.' }
          & "$env:TOOL_ROOT/tools/Scripts/python.exe" -m pip install --disable-pip-version-check `
            --only-binary=:all: --require-hashes -r windows/toolchain/python-tools.lock.txt
          if ($LASTEXITCODE -ne 0) { throw 'CTest provisioning refused; selecting full build.' }
      - name: Test current PR shell against verified native build (no pair evidence)
        if: steps.verify.outcome == 'success' && steps.runtime.outcome == 'success'
        run: |
          $lock = Get-Content windows/sources.lock.json -Raw | ConvertFrom-Json
          & powershell.exe -NoProfile -NonInteractive -File windows/ci/Invoke-PairIntegration.ps1 `
            -TestOnly -ShellRoot $env:GITHUB_WORKSPACE -BackendRoot "$env:GITHUB_WORKSPACE/windows/deps/quickshell" `
            -Mode pinned -BackendSha $lock.quickshell.revision -ToolRoot $env:TOOL_ROOT `
            -BuildRoot $env:BUILD_ROOT -Results C:/reuse-tests -JUnit C:/reuse-tests/unused.xml -EchoDiagnostics
          if ($LASTEXITCODE -ne 0) { throw 'Verified-native PR tests failed.' }
      - name: Separate reuse summary or explicit full-build fallback
        if: always()
        env:
          PRODUCER_BASE: ${{ steps.producer.outputs.base }}
        run: |
          if (Test-Path C:/reuse-tests/reuse-tests.json) {
            python -I -B windows/ci/native_reuse.py summary --base $env:PRODUCER_BASE `
              --output C:/native-reuse-summary.json --tests C:/reuse-tests
            if ($LASTEXITCODE -ne 0) { throw 'Reuse summary failed.' }
          } else {
            'Native reuse unavailable or refused. Full fixtures/build/pair validation is required.' >> $env:GITHUB_STEP_SUMMARY
          }
      - name: Retain separate reuse summary only
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: native-reuse-summary-${{ github.run_id }}
          path: C:/native-reuse-summary.json
          if-no-files-found: ignore
          retention-days: 3

  fixtures:
    name: Backend fixtures and portable tier
    needs: [scope, reuse]
    if: >-
      always() && needs.scope.result == 'success' &&
      (needs.scope.outputs.native == 'full' ||
      (needs.scope.outputs.native == 'reuse' && needs.reuse.result == 'success' && needs.reuse.outputs.mode == 'full'))
    runs-on: windows-2022
    timeout-minutes: 120
    defaults:
      run:
        shell: pwsh
        working-directory: C:\
    env:
      TOOL_ROOT: C:\t-public
      PIP_CACHE_DIR: C:\t-public\pip
      PAIR_RESULTS: C:\ci-pair
      TRUSTED_ROOT: C:\pair-trusted
      PYTHONDONTWRITEBYTECODE: '1'
      SCCACHE_DIR: C:\sccache-fixtures
    steps:
      - name: Checkout recursive sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          submodules: recursive
          persist-credentials: false
      - name: Python 3.12
        id: python
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Resolve exact pair and trusted producer
        env:
          PAIR_MODE: ${{ inputs.mode || 'pinned' }}
          PAIR_BACKEND: ${{ inputs.backend_sha }}
          PAIR_SHELL: ${{ inputs.shell_sha || github.sha }}
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Resolve-PairRequest.ps1" `
            -Mode $env:PAIR_MODE -BackendSha $env:PAIR_BACKEND -ShellSha $env:PAIR_SHELL `
            -ShellRoot $env:GITHUB_WORKSPACE -CandidateRoot C:\pair-backend -Results $env:PAIR_RESULTS
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" bootstrap `
            --shell $env:GITHUB_WORKSPACE --backend $local.backendRoot --target $env:TRUSTED_ROOT
          if ($LASTEXITCODE -ne 0) { throw 'Trusted producer extraction or digest check failed.' }
      - name: Initialize downstream receipt and inspect sources
        run: |
          $request = Get-Content "$env:PAIR_RESULTS\pair-request.json" -Raw | ConvertFrom-Json
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          $validator = "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py"
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" init `
            --kind downstream --backend-sha $request.backend --shell-sha $request.shell
          if ($LASTEXITCODE -ne 0) { throw 'Downstream receipt initialization failed.' }
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" sources `
            --backend $local.backendRoot --shell $env:GITHUB_WORKSPACE
          if ($LASTEXITCODE -ne 0) { throw 'Exact source verification failed.' }
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" run `
            --stage producer --unittest --echo -- python -B -m unittest discover `
            -s "$env:TRUSTED_ROOT\.github\candidate-contract" -p "test_*.py"
          if ($LASTEXITCODE -ne 0) { throw 'Producer contract fixtures failed.' }
      - name: Restore versioned tooling (never save)
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          key: windows-x64-tools-contract-v1-py${{ steps.python.outputs.python-version }}-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}
          path: |
            C:\t-public\Qt
            C:\t-public\downloads
            C:\t-public\pip
            C:\t-public\clang+llvm-20.1.8-x86_64-pc-windows-msvc
            C:\t-public\deps\CLI11-2.5.0
      - name: Prepare pinned tooling
        run: |
          python -I -B "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py" `
            --receipt "$env:PAIR_RESULTS\candidate-result.json" run --stage prepare --echo -- `
            powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\scripts\Prepare-Toolchain.ps1" `
            -ToolRoot $env:TOOL_ROOT -InstallRust
          if ($LASTEXITCODE -ne 0) { throw 'Supported public toolchain preparation failed.' }
      - name: Prepare optional pinned compiler cache
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Prepare-Sccache.ps1" -ToolRoot $env:TOOL_ROOT
      - name: Restore fixture objects (never save implicitly)
        id: objects
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          path: C:\sccache-fixtures
          key: windows-fixtures-objects-v1-sccache-0.15.0-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}-main-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: |
            windows-fixtures-objects-v1-sccache-0.15.0-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}-main-
      - name: Select build parallelism from runner hardware
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Get-BuildJobs.ps1"
      - name: Backend component build and portable tier
        env:
          QS_FIXTURE_COMPILER_LAUNCHER: ${{ env.CI_COMPILER_LAUNCHER }}
        run: |
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          Set-Location -LiteralPath $local.backendRoot
          $validator = "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py"
          $gate = "$env:TRUSTED_ROOT\.github\scripts\Invoke-WindowsFixtureGate.ps1"
          foreach ($phase in @('configure', 'build', 'portable')) {
            $testArguments = if ($phase -eq 'portable') { @('--junit', "$env:PAIR_RESULTS\portable.raw.xml") } else { @() }
            python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" run `
              --stage $phase --echo @testArguments -- powershell.exe -NoProfile -NonInteractive -File $gate `
              -Phase $phase -ContractRoot $env:GITHUB_WORKSPACE -ToolRoot $env:TOOL_ROOT `
              -BuildRoot C:\b-fixtures -Results $env:PAIR_RESULTS -Jobs $env:BUILD_JOBS
            if ($LASTEXITCODE -ne 0) { throw "Backend component phase failed: $phase" }
          }
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" inventory `
            --ctest "$env:TOOL_ROOT\tools\Scripts\ctest.exe" --build C:\b-fixtures
          if ($LASTEXITCODE -ne 0) { throw 'Backend tier inventory failed.' }
      - name: Record fixture compiler cache statistics and stop server
        if: always() && env.CI_COMPILER_LAUNCHER != ''
        id: cache-stats
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Complete-Sccache.ps1" `
            -Launcher $env:CI_COMPILER_LAUNCHER -Results C:\sccache-stats
      - name: Save fixtures objects from trusted main only
        # TEMPORARY measurement: GitHub confines PR writes to this PR merge ref.
        if: success() && steps.cache-stats.outcome == 'success' && (github.ref == 'refs/heads/main' && github.event_name == 'push' || github.event_name == 'pull_request' && github.head_ref == 'ci/sccache-native-builds')
        uses: actions/cache/save@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          path: C:\sccache-fixtures
          key: ${{ steps.objects.outputs.cache-primary-key }}
      - name: Fixture compiler cache evidence
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: sccache-fixtures-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/sccache-stats/
          retention-days: 7
          if-no-files-found: ignore
      - name: Transfer unfinalized fixture evidence
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: pair-fixtures-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 1
          if-no-files-found: error
          path: |
            C:/ci-pair/candidate-result.json
            C:/ci-pair/portable.xml
            C:/ci-pair/actual-toolchain.json
      - name: Public fixture toolchain receipts
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: fixtures-toolchain-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 3
          if-no-files-found: ignore
          path: C:/t-public/toolchain.json

  build:
    name: Native build and offscreen regressions
    needs: [scope, reuse]
    if: >-
      always() && needs.scope.result == 'success' &&
      (needs.scope.outputs.native == 'full' ||
      (needs.scope.outputs.native == 'reuse' && needs.reuse.result == 'success' && needs.reuse.outputs.mode == 'full'))
    runs-on: windows-2022
    timeout-minutes: 120
    defaults:
      run:
        shell: pwsh
        working-directory: C:\
    env:
      BUILD_ROOT: C:\b-public
      SCCACHE_DIR: C:\sccache-production
      TOOL_ROOT: C:\t-public
      PIP_CACHE_DIR: C:\t-public\pip
      DIAGNOSTICS: C:\ci-public
      SMOKE_ROOT: C:\ci-public\smoke
      PAIR_RESULTS: C:\ci-pair
      TRUSTED_ROOT: C:\pair-trusted
      PYTHONDONTWRITEBYTECODE: '1'

    steps:
      - name: Checkout recursive sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          submodules: recursive
          persist-credentials: false

      - name: Python 3.12
        id: python
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64

      - name: Resolve exact pair and trusted producer
        id: pair
        env:
          PAIR_MODE: ${{ inputs.mode || 'pinned' }}
          PAIR_BACKEND: ${{ inputs.backend_sha }}
          PAIR_SHELL: ${{ inputs.shell_sha || github.sha }}
        run: |
          $ErrorActionPreference = 'Stop'
          if (-not (Test-Path "$env:GITHUB_WORKSPACE\windows\ci\Resolve-PairRequest.ps1")) {
            throw 'Incompatible shell revision: exact-pair entry point is missing.'
          }
          & "$env:GITHUB_WORKSPACE\windows\ci\Resolve-PairRequest.ps1" `
            -Mode $env:PAIR_MODE -BackendSha $env:PAIR_BACKEND -ShellSha $env:PAIR_SHELL `
            -ShellRoot $env:GITHUB_WORKSPACE -CandidateRoot C:\pair-backend -Results $env:PAIR_RESULTS
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" bootstrap `
            --shell $env:GITHUB_WORKSPACE --backend $local.backendRoot --target $env:TRUSTED_ROOT
          if ($LASTEXITCODE -ne 0) { throw 'Trusted producer extraction or digest check failed.' }
      - name: Initialize downstream receipt and inspect sources
        run: |
          $ErrorActionPreference = 'Stop'
          $request = Get-Content "$env:PAIR_RESULTS\pair-request.json" -Raw | ConvertFrom-Json
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          $validator = "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py"
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" init `
            --kind downstream --backend-sha $request.backend --shell-sha $request.shell
          if ($LASTEXITCODE -ne 0) { throw 'Downstream receipt initialization failed.' }
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" sources `
            --backend $local.backendRoot --shell $env:GITHUB_WORKSPACE
          if ($LASTEXITCODE -ne 0) { throw 'Exact source verification failed.' }
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" run `
            --stage producer --unittest --echo -- python -B -m unittest discover `
            -s "$env:TRUSTED_ROOT\.github\candidate-contract" -p "test_*.py"
          if ($LASTEXITCODE -ne 0) { throw 'Producer contract fixtures failed.' }

      - name: Restore versioned tooling
        id: tools
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          key: windows-x64-tools-contract-v1-py${{ steps.python.outputs.python-version }}-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}
          path: |
            C:\t-public\Qt
            C:\t-public\downloads
            C:\t-public\pip
            C:\t-public\clang+llvm-20.1.8-x86_64-pc-windows-msvc
            C:\t-public\deps\CLI11-2.5.0

      - name: Prepare pinned tooling
        run: |
          $ErrorActionPreference = 'Stop'
          python -I -B "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py" `
            --receipt "$env:PAIR_RESULTS\candidate-result.json" run --stage prepare --echo -- `
            powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\scripts\Prepare-Toolchain.ps1" `
            -ToolRoot $env:TOOL_ROOT -InstallRust
          if ($LASTEXITCODE -ne 0) { throw 'Supported public toolchain preparation failed.' }

      - name: Save tooling from trusted main only
        if: steps.tools.outputs.cache-hit != 'true' && github.ref == 'refs/heads/main' && github.event_name == 'push'
        uses: actions/cache/save@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          key: ${{ steps.tools.outputs.cache-primary-key }}
          path: |
            C:\t-public\Qt
            C:\t-public\downloads
            C:\t-public\pip
            C:\t-public\clang+llvm-20.1.8-x86_64-pc-windows-msvc
            C:\t-public\deps\CLI11-2.5.0

      - name: Prepare optional pinned compiler cache
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Prepare-Sccache.ps1" -ToolRoot $env:TOOL_ROOT
      - name: Restore production objects (never save implicitly)
        id: objects
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          path: C:\sccache-production
          key: windows-production-objects-v1-sccache-0.15.0-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}-main-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: |
            windows-production-objects-v1-sccache-0.15.0-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}-main-

      - name: Select build parallelism from runner hardware
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Get-BuildJobs.ps1"

      - name: Early Services preflight (unrecorded; recorded integration reruns it)
        run: |
          $ErrorActionPreference = 'Stop'
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          $request = Get-Content "$env:PAIR_RESULTS\pair-request.json" -Raw | ConvertFrom-Json
          & powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\ci\Invoke-PairIntegration.ps1" `
            -ShellRoot $env:GITHUB_WORKSPACE -BackendRoot $local.backendRoot `
            -Mode $request.mode -BackendSha $request.backend -ToolRoot $env:TOOL_ROOT `
            -BuildRoot $env:BUILD_ROOT -Results $env:PAIR_RESULTS -JUnit "$env:PAIR_RESULTS\integration.raw.xml" `
            -ServicesPreflightRoot C:\ci-preflight -EchoDiagnostics
          if ($LASTEXITCODE -ne 0) { throw 'Early Services preflight failed before any native compilation.' }

      - name: First-party capture Rust regressions
        run: |
          & powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\scripts\Test-CaptureRust.ps1" `
            -ToolRoot $env:TOOL_ROOT -OutputRoot C:\ci-capture -Jobs $env:BUILD_JOBS
          if ($LASTEXITCODE -ne 0) { throw 'Capture Rust regressions failed or were empty.' }

      - name: Exact-pair production integration
        run: |
          $local = Get-Content "$env:PAIR_RESULTS\pair-local.json" -Raw | ConvertFrom-Json
          $request = Get-Content "$env:PAIR_RESULTS\pair-request.json" -Raw | ConvertFrom-Json
          # Isolated hosted fixtures only. Echo failures into the job log;
          # retained receipt/artifact output remains allowlisted.
          python -I -B "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py" `
            --receipt "$env:PAIR_RESULTS\candidate-result.json" run --stage integration --echo `
            --junit "$env:PAIR_RESULTS\integration.raw.xml" -- powershell.exe -NoProfile -NonInteractive `
            -File "$env:GITHUB_WORKSPACE\windows\ci\Invoke-PairIntegration.ps1" `
            -ShellRoot $env:GITHUB_WORKSPACE -BackendRoot $local.backendRoot `
            -Mode $request.mode -BackendSha $request.backend -ToolRoot $env:TOOL_ROOT -Jobs $env:BUILD_JOBS `
            -CompilerLauncher $env:CI_COMPILER_LAUNCHER `
            -BuildRoot $env:BUILD_ROOT -Results $env:PAIR_RESULTS -JUnit "$env:PAIR_RESULTS\integration.raw.xml" -EchoDiagnostics
          if ($LASTEXITCODE -ne 0) { throw 'Consuming-shell integration failed.' }

      - name: Record production compiler cache statistics and stop server
        if: always() && env.CI_COMPILER_LAUNCHER != ''
        id: cache-stats
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Complete-Sccache.ps1" `
            -Launcher $env:CI_COMPILER_LAUNCHER -Results C:\sccache-stats
      - name: Save production objects from trusted main only
        # TEMPORARY measurement: GitHub confines PR writes to this PR merge ref.
        if: success() && steps.cache-stats.outcome == 'success' && (github.ref == 'refs/heads/main' && github.event_name == 'push' || github.event_name == 'pull_request' && github.head_ref == 'ci/sccache-native-builds')
        uses: actions/cache/save@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          path: C:\sccache-production
          key: ${{ steps.objects.outputs.cache-primary-key }}
      - name: Production compiler cache evidence
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: sccache-production-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/sccache-stats/
          retention-days: 7
          if-no-files-found: ignore
      - name: Stage unfinalized integration inputs
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Export-NexusCandidateInputs.ps1" `
            -BuildRoot $env:BUILD_ROOT -PairResults $env:PAIR_RESULTS -OutputDirectory C:\integration-transfer -Integration
      - name: Stage reusable native tests from trusted main only
        if: success() && github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Export-NexusCandidateInputs.ps1" `
            -BuildRoot $env:BUILD_ROOT -OutputDirectory C:\native-reuse-transfer -Reuse
      - name: Retain trusted main native reuse inputs
        if: success() && github.event_name == 'push' && github.ref == 'refs/heads/main'
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: native-reuse-${{ github.sha }}
          path: C:/native-reuse-transfer/
          retention-days: 14
          if-no-files-found: error
          include-hidden-files: true
      - name: Transfer same-run integration inputs
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: pair-integration-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/integration-transfer/
          retention-days: 1
          if-no-files-found: error
          include-hidden-files: true

      - name: Public toolchain receipts
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: windows-toolchain-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 3
          if-no-files-found: ignore
          path: |
            C:/t-public/toolchain.json
            C:/b-public/logs/toolchain.json

      - name: Capture Rust result and native acceptance inventory
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: capture-rust-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 7
          if-no-files-found: warn
          path: C:/ci-capture/capture-rust.json

  pair:
    name: Exact-pair receipt
    needs: [scope, fixtures, build]
    if: >-
      always() && needs.scope.result == 'success' &&
      needs.scope.outputs.native != 'none' &&
      needs.fixtures.result == 'success' && needs.build.result == 'success'
    runs-on: windows-2022
    timeout-minutes: 15
    defaults:
      run:
        shell: pwsh
        working-directory: C:\
    env:
      BUILD_ROOT: C:\b-public
      PAIR_RESULTS: C:\ci-pair
      TRUSTED_ROOT: C:\pair-trusted
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Checkout recursive sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ inputs.shell_sha || github.sha }}
          submodules: recursive
          persist-credentials: false
      - name: Python 3.12
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Resolve exact pair and re-bootstrap trusted producer
        env:
          PAIR_MODE: ${{ inputs.mode || 'pinned' }}
          PAIR_BACKEND: ${{ inputs.backend_sha }}
          PAIR_SHELL: ${{ inputs.shell_sha || github.sha }}
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Resolve-PairRequest.ps1" `
            -Mode $env:PAIR_MODE -BackendSha $env:PAIR_BACKEND -ShellSha $env:PAIR_SHELL `
            -ShellRoot $env:GITHUB_WORKSPACE -CandidateRoot C:\pair-backend -Results C:\join-request
          $local = Get-Content C:\join-request\pair-local.json -Raw | ConvertFrom-Json
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" bootstrap `
            --shell $env:GITHUB_WORKSPACE --backend $local.backendRoot --target $env:TRUSTED_ROOT
          if ($LASTEXITCODE -ne 0) { throw 'Trusted producer extraction or digest check failed.' }
      - name: Download same-run fixture evidence
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: pair-fixtures-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/fixture-input
      - name: Download same-run integration evidence
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: pair-integration-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/
      - name: Require identical actual toolchains and merge unfinalized receipts
        run: |
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" join `
            --fixture C:\fixture-input --results $env:PAIR_RESULTS --shell $env:GITHUB_WORKSPACE `
            --validator "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py"
          if ($LASTEXITCODE -ne 0) { throw 'Toolchain equality check or receipt merge failed.' }
      - name: Finalize exact-pair receipt
        env:
          PAIR_OUTCOME: ${{ job.status }}
        run: |
          $validator = "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py"
          if (-not (Test-Path "$env:PAIR_RESULTS\pair-local.json") -or -not (Test-Path $validator)) {
            throw 'Pair never resolved or trusted validator unavailable; cannot claim pass.'
          }
          $local = Get-Content C:\join-request\pair-local.json -Raw | ConvertFrom-Json
          python -I -B $validator --receipt "$env:PAIR_RESULTS\candidate-result.json" finalize `
            --workflow-outcome $env:PAIR_OUTCOME --toolchain "$env:PAIR_RESULTS\actual-toolchain.json" `
            --backend $local.backendRoot --shell $env:GITHUB_WORKSPACE
          if ($LASTEXITCODE -ne 0) { throw 'Pair receipt is non-pass.' }

      - name: Independently validate pair and eligibility
        env:
          PAIR_OUTCOME: ${{ job.status }}
        run: |
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" envelope `
            --results $env:PAIR_RESULTS --shell $env:GITHUB_WORKSPACE `
            --build-root $env:BUILD_ROOT `
            --validator "$env:TRUSTED_ROOT\.github\scripts\candidate_contract.py" `
            --workflow-outcome $env:PAIR_OUTCOME --event $env:GITHUB_EVENT_NAME --ref $env:GITHUB_REF `
            --run-id $env:GITHUB_RUN_ID --attempt $env:GITHUB_RUN_ATTEMPT --workflow-sha $env:GITHUB_SHA
          if ($LASTEXITCODE -ne 0) { throw 'Independent pair validation is non-pass.' }

      - name: Stage exact assembly inputs only
        if: success() && github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Export-NexusCandidateInputs.ps1" `
            -BuildRoot $env:BUILD_ROOT -PairResults $env:PAIR_RESULTS -OutputDirectory C:\candidate-transfer

      - name: Transfer same-run assembly inputs
        if: success() && github.event_name == 'push' && github.ref == 'refs/heads/main'
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: nexus-inputs-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/candidate-transfer/
          retention-days: 1
          if-no-files-found: error
          include-hidden-files: true

      - name: Sanitized exact-pair receipts
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: pair-results-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 7
          if-no-files-found: warn
          path: |
            C:/ci-pair/pair-request.json
            C:/ci-pair/candidate-result.json
            C:/ci-pair/pair-result.json
            C:/ci-pair/portable.xml
            C:/ci-pair/integration.xml

      - name: Sanitized test summaries
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: offscreen-summary-${{ github.run_id }}
          path: |
            C:/ci-pair/Services/summary.json
            C:/ci-pair/Shell/summary.json
          if-no-files-found: ignore
          retention-days: 3

  validation:
    name: Windows validation
    if: always()
    needs: [scope, checks, packaging, reuse, fixtures, build, pair]
    runs-on: windows-2022
    timeout-minutes: 2
    steps:
      - name: Require every applicable gate
        shell: pwsh
        env:
          SCOPE: ${{ needs.scope.result }}
          CHECKS: ${{ needs.checks.result }}
          PACKAGING: ${{ needs.packaging.result }}
          BUILD: ${{ needs.build.result }}
          FIXTURES: ${{ needs.fixtures.result }}
          PAIR: ${{ needs.pair.result }}
          REUSE: ${{ needs.reuse.result }}
          REUSE_MODE: ${{ needs.reuse.outputs.mode }}
          NATIVE_REQUIRED: ${{ needs.scope.outputs.native }}
        run: |
          if ($env:SCOPE -ne 'success' -or $env:CHECKS -ne 'success' -or $env:PACKAGING -ne 'success') {
            throw 'Source or installer validation did not pass.'
          }
          if ($env:NATIVE_REQUIRED -notin @('none', 'reuse', 'full')) {
            throw 'The native-build decision is missing or invalid.'
          }
          $nativeResults = @($env:FIXTURES, $env:BUILD, $env:PAIR)
          $full = $env:NATIVE_REQUIRED -eq 'full'
          if ($env:NATIVE_REQUIRED -eq 'reuse') {
            if ($env:REUSE -ne 'success' -or $env:REUSE_MODE -notin @('reuse', 'full')) {
              throw 'Reuse validation or fallback decision did not pass.'
            }
            $full = $env:REUSE_MODE -eq 'full'
          } elseif ($env:REUSE -ne 'skipped') {
            throw 'Unexpected reuse-gate result.'
          }
          if ($full -and @($nativeResults | Where-Object { $_ -ne 'success' }).Count) {
            throw 'Required native validation did not pass.'
          }
          if (-not $full -and @($nativeResults | Where-Object { $_ -ne 'skipped' }).Count) {
            throw 'Unexpected native-gate result.'
          }

  candidate:
    name: Assemble exact-tested release candidate
    needs: [scope, pair, validation]
    # !cancelled(): the PR-only reuse job is skipped on every main push and sits
    # upstream via fixtures/build -> pair. The implicit success() treats that
    # skip as failure and silently skipped delivery. A cancelled run still does
    # not deliver; every required result is checked explicitly below.
    if: >-
      !cancelled() && github.event_name == 'push' && github.ref == 'refs/heads/main' &&
      needs.scope.result == 'success' && needs.scope.outputs.native == 'full' &&
      needs.pair.result == 'success' && needs.validation.result == 'success'
    runs-on: windows-2022
    timeout-minutes: 120
    outputs:
      candidate: ${{ steps.candidate.outcome == 'success' && format('nexus-candidate-{0}-{1}', github.run_id, github.run_attempt) || '' }}
    defaults:
      run:
        shell: pwsh
        working-directory: C:\
    env:
      BUILD_ROOT: C:\b-public
      TOOL_ROOT: C:\t-public
      PIP_CACHE_DIR: C:\t-public\pip
      PAIR_RESULTS: C:\ci-pair
      TRUSTED_ROOT: C:\pair-trusted
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Checkout exact recursive sources
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          submodules: recursive
          persist-credentials: false
      - name: Python 3.12
        id: python
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Resolve exact pinned pair and re-bootstrap trusted producer
        # Resolution also fetches backend refs/remotes/origin/main, which the
        # independent eligibility gate needs to recheck backend-main ancestry.
        run: |
          & "$env:GITHUB_WORKSPACE\windows\ci\Resolve-PairRequest.ps1" `
            -Mode pinned -ShellSha $env:GITHUB_SHA `
            -ShellRoot $env:GITHUB_WORKSPACE -CandidateRoot C:\pair-backend -Results C:\candidate-request
          $local = Get-Content C:\candidate-request\pair-local.json -Raw | ConvertFrom-Json
          python -I -B "$env:GITHUB_WORKSPACE\windows\ci\pair_result.py" bootstrap `
            --shell $env:GITHUB_WORKSPACE --backend $local.backendRoot --target $env:TRUSTED_ROOT
          if ($LASTEXITCODE -ne 0) { throw 'Trusted producer extraction or digest check failed.' }
      - name: Restore versioned tooling (never save)
        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        with:
          key: windows-x64-tools-contract-v1-py${{ steps.python.outputs.python-version }}-${{ hashFiles('windows/toolchain.json', 'windows/toolchain/*.lock.txt', 'windows/toolchain/extract_llvm.py') }}
          path: |
            C:\t-public\Qt
            C:\t-public\downloads
            C:\t-public\pip
            C:\t-public\clang+llvm-20.1.8-x86_64-pc-windows-msvc
            C:\t-public\deps\CLI11-2.5.0
      - name: Prepare pinned tooling
        run: |
          & powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\scripts\Prepare-Toolchain.ps1" `
            -ToolRoot $env:TOOL_ROOT -InstallRust
          if ($LASTEXITCODE -ne 0) { throw 'Supported public toolchain preparation failed.' }
      - name: Restore exact build and evidence paths
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: nexus-inputs-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/
      - name: Assemble exact-tested release candidate
        id: candidate
        run: |
          & powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\ci\New-NexusCandidate.ps1" `
            -ShellRoot $env:GITHUB_WORKSPACE -BuildRoot $env:BUILD_ROOT -ToolRoot $env:TOOL_ROOT `
            -PairResults $env:PAIR_RESULTS -TrustedRoot $env:TRUSTED_ROOT -OutputDirectory C:\nexus-candidate -EchoDiagnostics
          if ($LASTEXITCODE -ne 0) { throw 'Exact-tested candidate assembly failed.' }
      - name: Retain exact-tested release candidate
        if: steps.candidate.outcome == 'success'
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: nexus-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/nexus-candidate/out/
          retention-days: 7
          if-no-files-found: error
      - name: Sanitized candidate stage states
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: nexus-stage-states-${{ github.run_id }}-${{ github.run_attempt }}
          path: C:/nexus-candidate/private/*.state.json
          retention-days: 3
          if-no-files-found: ignore

  publish:
    name: Nexus development publication
    needs: [candidate, validation]
    # !cancelled() for the same skipped-ancestor reason as candidate; results
    # are checked explicitly.
    if: >-
      !cancelled() && github.event_name == 'push' && github.ref == 'refs/heads/main' &&
      needs.validation.result == 'success' && needs.candidate.result == 'success' &&
      needs.candidate.outputs.candidate != '' && vars.NEXUS_DEVELOPMENT_PUBLISH == 'enabled'
    runs-on: windows-2022
    timeout-minutes: 120
    environment: nexus-development
    concurrency:
      group: nexus-publication
      cancel-in-progress: false
    permissions:
      contents: write
      actions: read
    steps:
      - name: Checkout exact trusted source
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          submodules: recursive
          persist-credentials: false
      - name: Python 3.12
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Download this exact run and attempt only
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: ${{ needs.candidate.outputs.candidate }}
          path: C:/nexus-input
      - name: Verify immutable release and advance development pointer
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
          NEXUS_SIGNING_KEY: ${{ secrets.NEXUS_DEVELOPMENT_SIGNING_KEY }}
          NEXUS_DEVELOPMENT_PUBLISH: ${{ vars.NEXUS_DEVELOPMENT_PUBLISH }}
        run: |
          & powershell.exe -NoProfile -NonInteractive -File "$env:GITHUB_WORKSPACE\windows\ci\Invoke-NexusPublication.ps1" `
            -Mode development -CandidateDirectory C:\nexus-input -WorkDirectory C:\nexus-publish
          if ($LASTEXITCODE -ne 0) { throw 'Nexus development publication refused.' }
