# INERT minimal native recipe. The active workflow also runs regression gates:
# .github/workflows/windows-build.yml. Both consume windows/toolchain.json.
name: Windows native recipe
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    runs-on: windows-2022
    timeout-minutes: 60
    defaults:
      run:
        shell: pwsh
    env:
      TOOL_ROOT: C:\t-public
      BUILD_ROOT: C:\b-public
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          submodules: recursive
          persist-credentials: false
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          architecture: x64
      - name: Prepare and assert supported public tools
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Prepare-Toolchain.ps1 `
            -ToolRoot $env:TOOL_ROOT -InstallRust
          if ($LASTEXITCODE -ne 0) { throw 'Toolchain preparation failed.' }
      - name: Build production payload
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Build-Prototype.ps1 `
            -BuildRoot $env:BUILD_ROOT -QtPrefix "$env:TOOL_ROOT\Qt\6.11.2\msvc2022_64" `
            -LlvmBin "$env:TOOL_ROOT\clang+llvm-20.1.8-x86_64-pc-windows-msvc\bin" `
            -Cli11Include "$env:TOOL_ROOT\deps\CLI11-2.5.0\include" `
            -ToolsBin "$env:TOOL_ROOT\tools\Scripts" -PublicRelease
          if ($LASTEXITCODE -ne 0) { throw 'Native build failed.' }
      - name: Release receipt preflight
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/New-CaelestiaRelease.ps1 `
            -BuildRoot $env:BUILD_ROOT -ValidateToolchainOnly
          if ($LASTEXITCODE -ne 0) { throw 'Incompatible release toolchain.' }
      - name: Offscreen smoke
        run: |
          & powershell.exe -NoProfile -NonInteractive -File windows/scripts/Test-Smoke.ps1 `
            -BuildRoot $env:BUILD_ROOT -QtPrefix "$env:TOOL_ROOT\Qt\6.11.2\msvc2022_64"
          if ($LASTEXITCODE -ne 0) { throw 'Offscreen smoke failed.' }
      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        if: always()
        with:
          name: toolchain-receipts
          path: |
            C:/t-public/toolchain.json
            C:/b-public/logs/toolchain.json
          if-no-files-found: ignore
          retention-days: 3
